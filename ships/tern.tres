to_port = "heat_in"

[resource]
script = ExtResource("ship")
schema_version = 1
id = "tern"
display_name = "Tern"
ambient_temperature = 10.0
components = Array[Resource]([SubResource("utility_reactor"), SubResource("distribution_bus"), SubResource("port_bus"), SubResource("starboard_bus"), SubResource("port_pump_feed"), SubResource("starboard_pump_feed"), SubResource("core_pump"), SubResource("port_pump"), SubResource("starboard_pump"), SubResource("core_exchanger"), SubResource("port_engine"), SubResource("starboard_engine"), SubResource("radiator"), SubResource("coolant_reservoir"), SubResource("life_support"), SubResource("avionics"), SubResource("hull_services"), SubResource("shielding"), SubResource("sensors"), SubResource("habitat")])
assemblies = Array[Resource]([SubResource("assembly_engineering"), SubResource("assembly_utility_plant"), SubResource("assembly_utility_distribution"), SubResource("assembly_twin_drive"), SubResource("assembly_port_drive"), SubResource("assembly_starboard_drive"), SubResource("assembly_port_module"), SubResource("assembly_starboard_module"), SubResource("assembly_heat_rejection")])
connections = Array[Resource]([SubResource("link_source_trunk"), SubResource("link_trunk_port"), SubResource("link_trunk_starboard"), SubResource("link_feed_life_support"), SubResource("link_feed_avionics"), SubResource("link_feed_hull_services"), SubResource("link_feed_shielding"), SubResource("link_feed_sensors"), SubResource("link_feed_habitat"), SubResource("link_feed_core_pump"), SubResource("link_port_engine_power"), SubResource("link_port_pump_source"), SubResource("link_port_pump_power"), SubResource("link_starboard_engine_power"), SubResource("link_starboard_pump_source"), SubResource("link_starboard_pump_power"), SubResource("link_core_circulation"), SubResource("link_radiator_circulation"), SubResource("link_port_circulation"), SubResource("link_starboard_circulation"), SubResource("link_core_heat"), SubResource("link_core_to_coolant"), SubResource("link_port_to_coolant"), SubResource("link_starboard_to_coolant"), SubResource("link_coolant_to_radiator")])
views = Array[Dictionary]([
  {
    "id": "reactor",
    "name": "Reactor",
    "kind": "summary",
    "summary_kind": "reactor",
    "description": "Shared generation for two utility drives",
    "detail": "One reactor supplies both branches through the common trunk.",
    "members": [
      "utility_reactor"
    ]
  },
  {
    "id": "power",
    "name": "Power",
    "kind": "workspace",
    "summary_kind": "power",
    "description": "Shared trunk, independent drives, and pump isolation",
    "detail": "Open a pump feed, then follow the loss of engine cooling.",
    "members": [
      "utility_reactor",
      "distribution_bus",
      "port_bus",
      "starboard_bus",
      "port_pump_feed",
      "starboard_pump_feed"
    ]
  },
  {
    "id": "propulsion",
    "name": "Propulsion",
    "kind": "summary",
    "summary_kind": "thrust",
    "description": "Port and starboard utility drives",
    "detail": "Separate drive loops share the reactor and radiator.",
    "members": [
      "port_engine",
      "starboard_engine"
    ]
  },
  {
    "id": "cooling",
    "name": "Cooling",
    "kind": "workspace",
    "summary_kind": "temperature",
    "description": "Independent drive circulation and shared heat rejection",
    "detail": "Separate drive pumps; shared core cooling and heat rejection.",
    "members": [
      "core_pump",
      "core_exchanger",
      "radiator",
      "port_pump",
      "port_engine",
      "starboard_pump",
      "starboard_engine",
      "coolant_reservoir"
    ]
  },
  {
    "id": "life_support",
    "name": "Life support",
    "kind": "summary",
    "summary_kind": "load",
    "description": "Cabin and habitat electrical services",
    "detail": "Crew services are supplied before propulsion loads.",
    "members": [
      "life_support",
      "habitat"
    ]
  },
  {
    "id": "shielding",
    "name": "Radiation protection",
    "nav_name": "Radiation",
    "kind": "summary",
    "summary_kind": "load",
    "description": "Radiation-protection services",
    "detail": "Protective standby electronics on the shared trunk.",
    "members": [
      "shielding"
    ]
  },
  {
    "id": "sensors",
    "name": "Sensors",
    "kind": "summary",
    "summary_kind": "load",
    "description": "Survey and approach sensors",
    "detail": "The sensor suite has its own priority on the shared trunk.",
    "members": [
      "sensors"
    ]
  },
  {
    "id": "hull",
    "name": "Hull & compartments",
    "nav_name": "Hull",
    "kind": "summary",
    "summary_kind": "load",
    "description": "Compartment and utility handling electronics",
    "detail": "Electrical utility services; structural damage is not modeled.",
    "members": [
